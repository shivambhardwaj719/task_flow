# TaskFlow Environment Configuration

PROJECT_NAME=TaskFlow
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Security (Generate a secure 32+ character random secret in production)
SECRET_KEY=taskflow-super-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://taskflow:taskflow_password@localhost:5432/taskflow_db
USE_SQLITE_FALLBACK=True

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=300
CACHE_VERSION_TTL=86400

# Celery Worker & Scheduler
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
OVERDUE_TASK_CHECK_INTERVAL_SECONDS=60
